{
  "manifest_version": 3,
  "name": "Opportunity Rescue",
  "version": "1.0.0",
  "description": "Paste a URL → extract deadline, eligibility, skills and get one Next Action.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "tabs"],
  "host_permissions": ["<all_urls>"]
}
